/*
    DeckOps Settings (T6 / BO2 MP), port of the MW3 offline hub (port_iw5/deckops_cac.gsc)
    Server-side GSC for the local Plutonium LAN server.
    Drop into: storage/t6/raw/scripts/mp/deckops_cac.gsc (MP only; Zombies never loads scripts/mp)

    Hub: Class Editor (five Pick 10 classes), Default Classes (BO2's own list), Map / Mode, Bot Warfare.
    - On joining: the five DeckOps classes or Default Classes, after spawning with a default (like BO1's menu).
    - Open: MATCH SETTINGS in the pause menu (our Lua hub, built from bo2_real menu/build_bo2_menu.py into the
      offline mods/deckops_offline/mod.ff). Its rows answer menuresponse("class", "dcac_hub_<row>") and the
      server runs that screen. Every screen is our BO2-style Lua menu deckopsmenu, filled through client dvars
      by showMenu() (same method as the MW3 menu).
    - Loadouts go through level.givecustomloadout, which _class::giveloadout calls last (same hook as
      Gun Game / OIC), so no stats are written.
    - Items come from the game's mp/statstable.csv and mp/attachmenttable.csv, in Create-a-Class order
      (column 9); names and pictures from dcacCatalog(), generated by gen_catalog.py from BO2's own strings.

    Controls: BO2's own menu controls (mouse, keyboard, controller).

    Credits:
        - Divity (k) - Original in-game CAC concept
        - CMT Frosty - HUD string overflow fix pattern
        - DeckOps Community
*/

#include common_scripts\utility;
#include maps\mp\_utility;
#include maps\mp\gametypes\_hud_util;

init()
{
    if (sessionmodeiszombiesgame())
        return;

    precachemenu("deckopsmenu");
    precachemenu("deckopssettings");

    dcacCatalog();
    buildItemData();
    if (getdvarint("dcac_selftest"))
        cacSelfTest();

    if (!cacModeOwnsLoadout())
    {
        level.dcac_prevloadout = level.givecustomloadout;
        level.givecustomloadout = ::dcacGiveLoadout;
    }

    level thread onPlayerConnect();
    level thread applyMatchOptions();
}

onPlayerConnect()
{
    for (;;)
    {
        level waittill("connected", player);
        if (player isBotPlayer())
            continue;
        player initCac();
        player thread watchMenuResponse();
        player thread watchJoin();
        player thread watchDeath();
    }
}

isBotPlayer()
{
    return (isdefined(self.pers["isBot"]) && self.pers["isBot"]) || self istestclient();
}

watchDeath()
{
    self endon("disconnect");
    for (;;)
    {
        self waittill("death");
        self cacCleanup();
    }
}

// Every menu function ends on death, so the bot pause, freeze and open flag are released here too.
// after: what our open menu does next, "close" (default), "hub" (back to Match Settings) or "keep" (stays open)
cacCleanup(after)
{
    if (isdefined(self.cac_ui))
    {
        botsResume();
        if (!isdefined(after)) after = "close";
        if (after != "keep")
            self cacSeq(after);
    }
    self.cac_ui = undefined;
    self.cac_menu = undefined;
    if (isdefined(self.cac_speed))
        self cacLock(false);
    self.cac_open = false;
}

// Test builds: +set dcac_debug 1 logs the menu flow to the server console.log (T6 writes no games_mp.log here)
dlog(msg)
{
    if (getdvarint("dcac_debug"))
        print("DCAC;" + self.name + ";" + msg + "\n");
}

// ---
// Item data from the game's tables

buildItemData()
{
    t = "mp/statstable.csv";
    level.cac = [];
    level.cac_atts = [];
    level.cac_slot = [];
    level.cac_cost = [];
    level.cac_sort = [];

    level.cac["cats_p"] = strtok("weapon_smg,weapon_assault,weapon_cqb,weapon_lmg,weapon_sniper,weapon_special", ",");
    level.cac["cats_p_name"] = strtok("Submachine Guns,Assault Rifles,Shotguns,Light Machine Guns,Sniper Rifles,Specials", ",");
    level.cac["cats_s"] = strtok("weapon_pistol,weapon_launcher,weapon_special", ",");
    level.cac["cats_s_name"] = strtok("Pistols,Launchers,Specials", ",");
    lists = strtok("perk1,perk2,perk3,lethal,tactical,wildcard,streak", ",");
    foreach (k in lists)
        level.cac[k] = [];

    for (i = 0; i < 256; i++)
    {
        row = tablelookuprownum(t, 0, i);
        if (row < 0)
            continue;
        group = tablelookupcolumnforrow(t, row, 2);
        ref = tablelookupcolumnforrow(t, row, 4);
        inCac = tablelookupcolumnforrow(t, row, 12);
        slot = tablelookupcolumnforrow(t, row, 13);
        if (ref == "")
            continue;

        if (group == "killstreak")
        {
            if (inCac == "0" && ref != "killstreak_null")
            {
                level.cac_cost[ref] = int(tablelookupcolumnforrow(t, row, 16));
                level.cac["streak"] = insertByCost(level.cac["streak"], ref);
            }
            continue;
        }
        if (inCac != "1")
            continue;
        // DLC items (Peacekeeper) may be missing from the install
        if (tablelookupcolumnforrow(t, row, 15) != "")
            continue;
        // Create-a-Class order within each list
        level.cac_sort[ref] = int(tablelookupcolumnforrow(t, row, 9));

        if (group == "specialty")
        {
            if (slot == "specialty1") addTo("perk1", ref);
            else if (slot == "specialty2") addTo("perk2", ref);
            else if (slot == "specialty3") addTo("perk3", ref);
        }
        else if (group == "bonuscard")
            addTo("wildcard", ref);
        else if (group == "weapon_grenade")
        {
            if (slot == "primarygrenade") addTo("lethal", ref);
            else if (slot == "specialgrenade") addTo("tactical", ref);
        }
        else if (issubstr(group, "weapon_") && (slot == "primary" || slot == "secondary"))
        {
            addTo("w_" + group + "_" + slot, ref);
            level.cac_slot[ref] = slot;
            // Table codes are per class (reflex_pistol, silencer_shotgun, rf_fast); the weapon name uses the base code
            atts = [];
            foreach (a in strtok(tablelookupcolumnforrow(t, row, 8), " "))
            {
                base = strtok(a, "_")[0];
                if (!isinarray(atts, base))
                    atts[atts.size] = base;
            }
            level.cac_atts[ref] = atts;
        }
    }
}

addTo(key, ref)
{
    if (!isdefined(level.cac[key]))
        level.cac[key] = [];
    out = [];
    placed = false;
    foreach (k in level.cac[key])
    {
        if (!placed && level.cac_sort[ref] < level.cac_sort[k])
        {
            out[out.size] = ref;
            placed = true;
        }
        out[out.size] = k;
    }
    if (!placed)
        out[out.size] = ref;
    level.cac[key] = out;
}

insertByCost(list, ref)
{
    out = [];
    placed = false;
    foreach (k in list)
    {
        if (!placed && level.cac_cost[ref] < level.cac_cost[k])
        {
            out[out.size] = ref;
            placed = true;
        }
        out[out.size] = k;
    }
    if (!placed)
        out[out.size] = ref;
    return out;
}

// Pair rules from mp/attachmenttable.csv (column 11 lists what each attachment can go with)
attCompatible(a, b)
{
    if (a == b)
        return false;
    return isinarray(strtok(tablelookup("mp/attachmenttable.csv", 4, a, 11), " "), b);
}

attIndex(a)
{
    return int(tablelookup("mp/attachmenttable.csv", 4, a, 0));
}

// ---
// Display names and pictures from dcacCatalog() (keyed by code; perks by their first specialty)

cacName(code)
{
    if (!isdefined(code) || code == "none")
        return "None";
    if (issubstr(code, "|"))
        code = strtok(code, "|")[0];
    if (isdefined(level.cac_names[code]))
        return level.cac_names[code];
    return code;
}

// ---
// Five classes in self.dcac[0..4]; every edit goes to self.dcac[self.dcac_cur]. Saved per player in server
// dvars dcac_<guid>_<n> (one class each, a dvar holds 1024 characters at most) and dcac_use_<guid> (the class
// in use, "-" for none), so they survive map changes, and in scriptdata/deckops_bo2_<guid>.txt (the same six
// values, one per line), so they survive a server restart

cacKeys()
{
    return strtok("p,p_a1,p_a2,p_a3,s,s_a1,s_a2,lethal,lethal_n,tac,tac_n,perk1,perk1b,perk2,perk2b,perk3,perk3b,wc1,wc2,wc3,ks1,ks2,ks3", ",");
}

cacDefault()
{
    l = [];
    foreach (k in cacKeys())
        l[k] = "none";
    l["p"] = "tar21"; l["p_a1"] = "reflex"; l["s"] = "fiveseven";
    l["lethal"] = "frag_grenade"; l["lethal_n"] = "1"; l["tac"] = "concussion_grenade"; l["tac_n"] = "1";
    l["perk1"] = "specialty_movefaster|specialty_fallheight"; l["perk2"] = "specialty_bulletflinch";
    l["perk3"] = "specialty_fastmantle|specialty_fastladderclimb|specialty_sprintrecovery|specialty_fastmeleerecovery";
    l["ks1"] = "killstreak_rcbomb"; l["ks2"] = "killstreak_spyplane"; l["ks3"] = "killstreak_missile_drone";
    return l;
}

cacParse(saved)
{
    l = cacDefault();
    keys = cacKeys();
    vals = strtok(saved, ",");
    if (vals.size == keys.size)
        for (i = 0; i < keys.size; i++)
            l[keys[i]] = vals[i];
    return l;
}

initCac()
{
    self cacReadFile();
    // Round A kept one loadout (dcac_<guid>, dcac_on_<guid>): it becomes Class 1
    if (getdvar("dcac_" + self.guid + "_0") == "" && getdvar("dcac_" + self.guid) != "")
    {
        setdvar("dcac_" + self.guid + "_0", getdvar("dcac_" + self.guid));
        if (getdvar("dcac_on_" + self.guid) == "1") setdvar("dcac_use_" + self.guid, "0");
    }
    self.dcac = [];
    for (n = 0; n < 5; n++)
        self.dcac[n] = cacParse(getdvar("dcac_" + self.guid + "_" + n));
    self.dcac_cur = 0;
    self.dcac_use = undefined;
    use = getdvar("dcac_use_" + self.guid);
    if (use != "" && use != "-")
        self.dcac_use = int(use);
}

cacSave()
{
    str = "";
    foreach (k in cacKeys())
    {
        if (str != "") str += ",";
        str += self.dcac[self.dcac_cur][k];
    }
    setdvar("dcac_" + self.guid + "_" + self.dcac_cur, str);
    self cacWriteFile();
    self cacSendClasses();
}

// The class in use (undefined: BO2's own class)
cacSetUse(n)
{
    self.dcac_use = n;
    if (isdefined(n)) setdvar("dcac_use_" + self.guid, "" + n);
    else setdvar("dcac_use_" + self.guid, "-");
    self cacWriteFile();
}

cacFile()
{
    return "deckops_bo2_" + self.guid + ".txt";
}

cacWriteFile()
{
    f = fs_fopen(self cacFile(), "write");
    for (n = 0; n < 5; n++)
        fs_writeline(f, getdvar("dcac_" + self.guid + "_" + n));
    fs_writeline(f, getdvar("dcac_use_" + self.guid));
    fs_fclose(f);
}

// Fresh server (no dvars yet): load the classes saved by an earlier session, or Round A's single loadout
// (deckops_class_<guid>.txt: picks, use it)
cacReadFile()
{
    if (getdvar("dcac_" + self.guid + "_0") != "" || getdvar("dcac_" + self.guid) != "")
        return;
    if (fs_testfile(self cacFile()))
    {
        f = fs_fopen(self cacFile(), "read");
        names = [];
        for (n = 0; n < 5; n++)
            names[n] = "dcac_" + self.guid + "_" + n;
        names[5] = "dcac_use_" + self.guid;
    }
    else if (fs_testfile("deckops_class_" + self.guid + ".txt"))
    {
        f = fs_fopen("deckops_class_" + self.guid + ".txt", "read");
        names = strtok("dcac_" + self.guid + ",dcac_on_" + self.guid, ",");
    }
    else
        return;
    // empty lines (never saved) stay unset
    foreach (name in names)
    {
        line = fs_readline(f);
        if (isdefined(line) && strtok(line, "\r\n").size == 1)
            setdvar(name, strtok(line, "\r\n")[0]);
    }
    fs_fclose(f);
}

cacGet(key)
{
    return self.dcac[self.dcac_cur][key];
}

cacSet(key, value)
{
    self.dcac[self.dcac_cur][key] = value;
    self cacSave();
}

hasWc(ref)
{
    return self cacGet("wc1") == ref || self cacGet("wc2") == ref || self cacGet("wc3") == ref;
}

attKeys(slot)
{
    if (slot == "p")
        return strtok("p_a1,p_a2,p_a3", ",");
    return strtok("s_a1,s_a2", ",");
}

maxAtts(slot)
{
    if (slot == "p")
    {
        if (self hasWc("bonuscard_primary_gunfighter")) return 3;
        return 2;
    }
    if (self hasWc("bonuscard_secondary_gunfighter")) return 2;
    return 1;
}

// Tactical Insertion, Trophy System and Black Hat come one at a time
tacMulti(t)
{
    return t != "tactical_insertion" && t != "trophy_system" && t != "pda_hack";
}

// Brings everything back inside the wildcard rules after a wildcard or weapon change
cacSanitize()
{
    foreach (slot in strtok("p,s", ","))
    {
        w = self cacGet(slot);
        if (w != "none" && !isdefined(level.cac_slot[w]))
        {
            self cacSet(slot, "none");
            w = "none";
        }
        if (slot == "s" && w != "none" && level.cac_slot[w] == "primary" && !self hasWc("bonuscard_overkill"))
        {
            self cacSet("s", "none");
            w = "none";
        }
        // Each attachment stays in its own row; the wildcard row needs Gunfighter
        kept = [];
        keys = attKeys(slot);
        for (i = 0; i < keys.size; i++)
        {
            a = self cacGet(keys[i]);
            ok = a != "none" && w != "none" && isdefined(level.cac_atts[w]) && isinarray(level.cac_atts[w], a) && i < self maxAtts(slot);
            foreach (b in kept)
                if (ok && !attCompatible(b, a))
                    ok = false;
            if (ok)
                kept[kept.size] = a;
            else
                self cacSet(keys[i], "none");
        }
    }
    for (t = 1; t <= 3; t++)
        if (!self hasWc("bonuscard_perk_" + t + "_greed") || self cacGet("perk" + t) == "none")
            self cacSet("perk" + t + "b", "none");
    if (self cacGet("lethal") != "none" && !isinarray(level.cac["lethal"], self cacGet("lethal")) && !self hasWc("bonuscard_two_tacticals"))
        self cacSet("lethal", "none");
    if (!self hasWc("bonuscard_danger_close"))
        self cacSet("lethal_n", "1");
    if (!tacMulti(self cacGet("tac")))
        self cacSet("tac_n", "1");
}

// ---
// Loadout hook: _class::giveloadout calls level.givecustomloadout last and uses its return as the spawn weapon

cacUsesDeckops()
{
    return !self isBotPlayer() && isdefined(self.dcac) && isdefined(self.dcac_use);
}

dcacGiveLoadout()
{
    if (!self cacUsesDeckops())
    {
        if (isdefined(level.dcac_prevloadout))
            return self [[level.dcac_prevloadout]]();
        return undefined;
    }

    // Everything below reads the class in use; the editor may have another one open
    edit = self.dcac_cur;
    self.dcac_cur = self.dcac_use;
    self takeallweapons();

    // perks first: Scavenger and friends are checked while giving weapons
    self.specialty = [];
    foreach (k in strtok("perk1,perk1b,perk2,perk2b,perk3,perk3b", ","))
        if (self cacGet(k) != "none")
            foreach (s in strtok(self cacGet(k), "|"))
                self.specialty[self.specialty.size] = s;
    self maps\mp\gametypes\_class::register_perks();
    self maps\mp\gametypes\_class::cac_selector();

    self giveweapon("knife_mp");
    prim = self cacWeaponName("p");
    sec = self cacWeaponName("s");
    spawnweapon = "";
    if (sec != "")
    {
        self giveweapon(sec);
        if (self hasperk("specialty_extraammo")) self givemaxammo(sec);
        spawnweapon = sec;
    }
    if (prim != "")
    {
        self giveweapon(prim);
        if (self hasperk("specialty_extraammo")) self givemaxammo(prim);
        spawnweapon = prim;
        self.pers["primaryWeapon"] = self cacGet("p");
    }
    if (prim == "" || sec == "")
    {
        self giveweapon("knife_held_mp");
        if (spawnweapon == "") spawnweapon = "knife_held_mp";
    }
    self setspawnweapon(spawnweapon);
    self.spawnweapon = spawnweapon;
    self.pers["spawnWeapon"] = spawnweapon;

    self.grenadetypeprimary = undefined;
    self.grenadetypesecondary = undefined;
    if (self cacGet("lethal") != "none")
    {
        g = self cacGet("lethal") + "_mp";
        n = int(self cacGet("lethal_n"));
        self giveweapon(g);
        self setweaponammoclip(g, n);
        self switchtooffhand(g);
        self.grenadetypeprimary = g;
        self.grenadetypeprimarycount = n;
        if (n > 1) self dualgrenadesactive();
    }
    if (self cacGet("tac") != "none")
    {
        g = self cacGet("tac") + "_mp";
        n = int(self cacGet("tac_n"));
        self setoffhandsecondaryclass(g);
        self giveweapon(g);
        self setweaponammoclip(g, n);
        self.grenadetypesecondary = g;
        self.grenadetypesecondarycount = n;
    }

    self cacGiveStreaks();
    if (prim != "")
        self maps\mp\teams\_teams::set_player_model(self.team, prim);
    self.dcac_cur = edit;
    return spawnweapon;
}

// Weapon name the game builds: base[_dw]_mp+att+att, attachments in attachment table order
cacWeaponName(slot)
{
    w = self cacGet(slot);
    if (w == "none")
        return "";
    atts = [];
    dw = false;
    foreach (k in attKeys(slot))
    {
        a = self cacGet(k);
        if (a == "dw") dw = true;
        else if (a != "none") atts[atts.size] = a;
    }
    for (i = 0; i < atts.size; i++)
        for (j = i + 1; j < atts.size; j++)
            if (attIndex(atts[j]) < attIndex(atts[i]))
            {
                tmp = atts[i]; atts[i] = atts[j]; atts[j] = tmp;
            }
    name = w;
    if (dw) name += "_dw";
    name += "_mp";
    foreach (a in atts)
        name += "+" + a;
    return name;
}

// Same as _class::givekillstreaks, from the DeckOps picks instead of the stats class.
// Earning reads self.killstreak (_globallogic_score::_setplayermomentum).
cacGiveStreaks()
{
    self.killstreak = [];
    if (!level.loadoutkillstreaksenabled)
        return;
    sorted = [];
    for (n = 1; n <= 3; n++)
    {
        ks = self cacGet("ks" + n);
        if (ks == "none")
            continue;
        self.killstreak[self.killstreak.size] = ks;
        if (!(isdefined(level.usingmomentum) && level.usingmomentum))
            continue;
        type = maps\mp\killstreaks\_killstreaks::getkillstreakbymenuname(ks);
        if (!isdefined(type))
            continue;
        weapon = maps\mp\killstreaks\_killstreaks::getkillstreakweapon(type);
        self giveweapon(weapon);
        if (isdefined(level.usingscorestreaks) && level.usingscorestreaks)
        {
            if (maps\mp\killstreaks\_killstreak_weapons::isheldkillstreakweapon(weapon))
            {
                if (!isdefined(self.pers["held_killstreak_ammo_count"][weapon])) self.pers["held_killstreak_ammo_count"][weapon] = 0;
                if (!isdefined(self.pers["held_killstreak_clip_count"][weapon])) self.pers["held_killstreak_clip_count"][weapon] = 0;
                if (self.pers["held_killstreak_ammo_count"][weapon] > 0)
                {
                    self setweaponammoclip(weapon, self.pers["held_killstreak_clip_count"][weapon]);
                    self setweaponammostock(weapon, self.pers["held_killstreak_ammo_count"][weapon] - self.pers["held_killstreak_clip_count"][weapon]);
                }
                else
                    self maps\mp\gametypes\_class::setweaponammooverall(weapon, 0);
            }
            else
            {
                quantity = self.pers["killstreak_quantity"][weapon];
                if (!isdefined(quantity)) quantity = 0;
                self setweaponammoclip(weapon, quantity);
            }
        }
        d = spawnstruct();
        d.cost = level.killstreaks[type].momentumcost;
        d.weapon = weapon;
        i = 0;
        while (i < sorted.size && sorted[i].cost <= d.cost)
            i++;
        for (j = sorted.size; j > i; j--)
            sorted[j] = sorted[j - 1];
        sorted[i] = d;
    }
    order = strtok("4,2,1", ",");
    for (i = 0; i < order.size; i++)
    {
        if (i < sorted.size) self setactionslot(int(order[i]), "weapon", sorted[i].weapon);
        else self setactionslot(int(order[i]), "");
    }
}

// Gun Game, One in the Chamber, Sharpshooter and Sticks and Stones hand out their own loadouts
cacModeOwnsLoadout()
{
    switch (level.gametype)
    {
        case "gun":
        case "oic":
        case "shrp":
        case "sas":
            return true;
    }
    return false;
}

// ---
// Opening, input, class list

watchMenuResponse()
{
    self endon("disconnect");
    for (;;)
    {
        self waittill("menuresponse", menu, response);
        self dlog("menuresponse " + menu + " " + response);
        // A Match Settings row (our Lua hub in the pause menu). A row while a screen is still running starts over,
        // so a menu that never showed can't leave the player stuck. Works before the first spawn too (real menus
        // don't need a spawned player like the old HUD did).
        if (menu == "class" && response.size > 9 && getsubstr(response, 0, 9) == "dcac_hub_")
        {
            if (self.cac_open)
            {
                self notify("dcac_restart");
                // the hub has already opened a new screen: don't close it
                self cacCleanup("keep");
            }
            self.cac_open = true;
            self thread openHubRow(getsubstr(response, 9));
        }
        // BO2's Choose Class (changeclass.lua) lists the DeckOps classes first (deckopscac.lua): a pick answers
        // dcac_choose_<n> instead of BO2's custom<n>, so BO2's Create-a-Class lock never applies
        if (menu == "class" && response.size > 12 && getsubstr(response, 0, 12) == "dcac_choose_" && !cacModeOwnsLoadout())
        {
            self.dcac_cur = int(getsubstr(response, 12));
            if (self.sessionstate == "playing")
                self applyLoadout();
            else
            {
                self cacSetUse(self.dcac_cur);
                // BO2's own pick spawns the player; the loadout hook gives the DeckOps class
                self.selectedclass = 1;
                self [[level.class]]("class_smg");
            }
        }
        // BO2's Choose Class opened: send all five again (the ones sent while joining can get lost)
        if (menu == "class" && response == "dcac_classes")
        {
            for (n = 0; n < 5; n++)
                if (isdefined(self.dcac_sent)) self.dcac_sent["dcac_cls" + n] = undefined;
            self cacSendClasses();
        }
        // One of BO2's own classes from the same list: the DeckOps class is off
        if (menu == "changeclass" && response != "back")
            self cacSetUse(undefined);
    }
}

// BO2 puts LAN players on a team itself and then opens its class list (joined_team, _globallogic_ui):
// the DeckOps classes it shows have to be there first
watchJoin()
{
    self endon("disconnect");
    for (;;)
    {
        self waittill("joined_team");
        self cacSendClasses();
    }
}

// A fresh profile starts like BO2's: Class 1-5 = BO2's five default classes (Operative, Specialist, Mercenary,
// Heavy Gunner, Scout Recon = class numbers 10-14 in _class.gsc). Reads only; once saved it is the player's.
cacSeedDefaults()
{
    if (isdefined(self.dcac_seeding) || !isdefined(self.dcac) || getdvar("dcac_" + self.guid + "_0") != "" || cacModeOwnsLoadout())
        return;
    self.dcac_seeding = true;
    cur = self.dcac_cur;
    for (k = 0; k < 5; k++)
        self cacSeedClass(k, 10 + k);
    self.dcac_cur = cur;
    self.dcac_seeding = undefined;
}

// DeckOps Class k + 1 from BO2's class number n (the stats' custom classes 0-9, default classes 10-14)
cacSeedClass(k, n)
{
    self.dcac_cur = k;
    foreach (k in cacKeys())
        self.dcac[self.dcac_cur][k] = "none";
    self cacParseWeapon("p", self getloadoutweapon(n, "primary"));
    self cacParseWeapon("s", self getloadoutweapon(n, "secondary"));

    perks = self getloadoutperks(n);
    for (t = 1; t <= 3; t++)
        foreach (ref in level.cac["perk" + t])
            if (isinarray(perks, strtok(ref, "|")[0]))
            {
                if (self.dcac[self.dcac_cur]["perk" + t] == "none") self.dcac[self.dcac_cur]["perk" + t] = ref;
                else self.dcac[self.dcac_cur]["perk" + t + "b"] = ref;
            }

    g = self getloadoutitemref(n, "primarygrenade");
    if (isinarray(level.cac["lethal"], g) || isinarray(level.cac["tactical"], g))
    {
        self.dcac[self.dcac_cur]["lethal"] = g;
        self.dcac[self.dcac_cur]["lethal_n"] = "" + max(1, self getloadoutitem(n, "primarygrenadecount"));
    }
    g = self getloadoutitemref(n, "specialgrenade");
    if (isinarray(level.cac["tactical"], g))
    {
        self.dcac[self.dcac_cur]["tac"] = g;
        self.dcac[self.dcac_cur]["tac_n"] = "" + max(1, self getloadoutitem(n, "specialgrenadecount"));
    }

    if (isdefined(self.killstreak))
        for (i = 0; i < self.killstreak.size && i < 3; i++)
            self.dcac[self.dcac_cur]["ks" + (i + 1)] = self.killstreak[i];

    // wildcards follow from what the class holds
    wc = [];
    if (self.dcac[self.dcac_cur]["p_a3"] != "none") wc[wc.size] = "bonuscard_primary_gunfighter";
    if (self.dcac[self.dcac_cur]["s_a2"] != "none") wc[wc.size] = "bonuscard_secondary_gunfighter";
    if (self.dcac[self.dcac_cur]["s"] != "none" && level.cac_slot[self.dcac[self.dcac_cur]["s"]] == "primary") wc[wc.size] = "bonuscard_overkill";
    for (t = 1; t <= 3; t++)
        if (self.dcac[self.dcac_cur]["perk" + t + "b"] != "none") wc[wc.size] = "bonuscard_perk_" + t + "_greed";
    if (int(self.dcac[self.dcac_cur]["lethal_n"]) > 1) wc[wc.size] = "bonuscard_danger_close";
    if (isinarray(level.cac["tactical"], self.dcac[self.dcac_cur]["lethal"])) wc[wc.size] = "bonuscard_two_tacticals";
    for (i = 0; i < wc.size && i < 3; i++)
        self.dcac[self.dcac_cur]["wc" + (i + 1)] = wc[i];

    self cacSanitize();
    self cacSave();
}

cacParseWeapon(slot, w)
{
    if (!isdefined(w))
        return;
    toks = strtok(w, "+");
    if (toks.size == 0 || !issubstr(toks[0], "_mp"))
        return;
    base = getsubstr(toks[0], 0, toks[0].size - 3);
    keys = attKeys(slot);
    k = 0;
    if (issubstr(base, "_dw"))
    {
        base = getsubstr(base, 0, base.size - 3);
        self.dcac[self.dcac_cur][keys[0]] = "dw";
        k = 1;
    }
    if (!isdefined(level.cac_slot[base]))
        return;
    self.dcac[self.dcac_cur][slot] = base;
    for (i = 1; i < toks.size && k < keys.size; i++)
    {
        self.dcac[self.dcac_cur][keys[k]] = toks[i];
        k++;
    }
}

// ---
// Hub

// One Match Settings row; Back on its screen brings the hub back
openHubRow(key)
{
    self endon("disconnect");
    self endon("death");
    self endon("dcac_restart");

    // the hub opened deckopsmenu itself; the server only fills it
    self.cac_menu = true;
    self cacSeedDefaults();
    switch (key)
    {
        case "class_editor":
            if (cacModeOwnsLoadout())
                self iprintlnbold("^1This mode uses its own loadouts");
            else if (self openClassList())
                return;
            break;
        case "map_mode":
            if (self openMatchMenu())
                return;
            break;
        case "bot_warfare":
            self openBotMenu();
            break;
    }
    self cacCleanup("hub");
}

// Paged list, returns the picked index or -1. 15 rows fit above the prompt, so every Create-a-Class list
// fits on one page (Ray: avoid More); only a longer list pages with More
pickList(title, names, current)
{
    if (!isdefined(current)) current = -1;
    page = 0;
    if (current > 0 && names.size > 15) page = int(current / 14);
    for (;;)
    {
        first = 0;
        per = 15;
        if (names.size > 15)
        {
            first = page * 14;
            per = 14;
        }
        rows = [];
        for (i = first; i < names.size && i < first + per; i++)
            rows[rows.size] = names[i];
        more = first + per < names.size;
        if (more) rows[rows.size] = "More";
        else if (page > 0) rows[rows.size] = "Back to Start";
        if (current >= first && current < first + per) self.cac_startIndex = current - first;
        r = self showMenu(title, rows);
        if (r == -1)
            return -1;
        if (first + r < names.size && r < per)
            return first + r;
        if (more) page++;
        else page = 0;
    }
}

// ---
// Class Editor (returns true when a class was put in use and the menu closed)

classItems()
{
    items = [];
    for (n = 0; n < 5; n++)
    {
        items[n] = "Class " + (n + 1) + ": " + cacName(self.dcac[n]["p"]);
        if (isdefined(self.dcac_use) && self.dcac_use == n)
            items[n] += " (in use)";
    }
    return items;
}

openClassList()
{
    index = 0;
    if (isdefined(self.dcac_use)) index = self.dcac_use;
    for (;;)
    {
        self.cac_startIndex = index;
        r = self showMenu("CLASS EDITOR", self classItems());
        if (r == -1)
            return false;
        index = r;
        self.dcac_cur = r;
        if (self editClassBo2())
            return true;
    }
}

// ---
// BO2's own Create-a-Class (deckopscac.lua) edits the class: it gets the class in BO2's item numbers and answers each
// change as dcac_set_<slot>_<value>. Items are statstable column 0 <-> 4; attachments are numbered per weapon
// (1 = first in its statstable column 8 list; Skorpion EVO grip = 6), read with the engine's getitemattachment as
// _class.gsc does. attachmenttable column 0 is no use here: camo, reticle and lens rows reuse its numbers.

cacBo2Slots()
{
    m = [];
    m["primary"] = "p"; m["secondary"] = "s";
    m["primarygrenade"] = "lethal"; m["specialgrenade"] = "tac";
    m["specialty1"] = "perk1"; m["specialty2"] = "perk2"; m["specialty3"] = "perk3";
    m["specialty4"] = "perk1b"; m["specialty5"] = "perk2b"; m["specialty6"] = "perk3b";
    m["bonuscard1"] = "wc1"; m["bonuscard2"] = "wc2"; m["bonuscard3"] = "wc3";
    m["killstreak1"] = "ks1"; m["killstreak2"] = "ks2"; m["killstreak3"] = "ks3";
    return m;
}

cacItemNum(ref)
{
    if (!isdefined(ref) || ref == "none")
        return 0;
    return int(tablelookup("mp/statstable.csv", 4, ref, 0));
}

cacItemRef(num)
{
    if (!isdefined(num) || num == 0)
        return "none";
    return tablelookup("mp/statstable.csv", 0, num, 4);
}

cacAttNum(weapon, att)
{
    if (att == "none" || weapon == "none")
        return 0;
    w = cacItemNum(weapon);
    // past the list the engine answers "none"; 16 covers the longest list and its double spaces
    for (n = 1; n <= 16; n++)
        if (getitemattachment(w, n) == att)
            return n;
    return 0;
}

cacAttRef(weapon, num)
{
    if (!isdefined(num) || num == 0 || weapon == "none")
        return "none";
    return getitemattachment(cacItemNum(weapon), num);
}

// +set dcac_selftest 1 (lan_check.sh): every item and attachment DeckOps offers converts to BO2's numbers and back
// (an attachment the engine doesn't list for that gun shows as 0); results in the server console.log
cacSelfTest()
{
    items = 0;
    atts = 0;
    bad = 0;
    refs = getarraykeys(level.cac_slot);
    foreach (key in strtok("perk1,perk2,perk3,lethal,tactical,wildcard,streak", ","))
        foreach (ref in level.cac[key])
            refs[refs.size] = ref;
    foreach (ref in refs)
    {
        items++;
        if (cacName(ref) == ref)
        {
            bad++;
            print("dcac selftest no name " + ref + "\n");
        }
        n = cacItemNum(ref);
        if (n == 0 || cacItemRef(n) != ref)
        {
            bad++;
            print("dcac selftest item " + ref + " -> " + n + " -> " + cacItemRef(n) + "\n");
        }
    }
    foreach (w in getarraykeys(level.cac_atts))
        foreach (a in level.cac_atts[w])
        {
            atts++;
            if (cacName(a) == a)
            {
                bad++;
                print("dcac selftest no name " + w + " " + a + "\n");
            }
            n = cacAttNum(w, a);
            if (n == 0 || cacAttRef(w, n) != a || getitemattachment(cacItemNum(w), n) != a)
            {
                bad++;
                print("dcac selftest attachment " + w + " " + a + " -> " + n + " -> " + cacAttRef(w, n) + " engine " + getitemattachment(cacItemNum(w), n) + "\n");
            }
        }
    print("dcac selftest done: " + items + " items, " + atts + " attachments, " + bad + " bad\n");
}

// Class n in BO2's numbers (deckopscac.lua reads them as "slot=value,...")
cacRaw(n)
{
    l = self.dcac[n];
    raw = [];
    m = cacBo2Slots();
    foreach (k in getarraykeys(m))
        raw[k] = cacItemNum(l[m[k]]);
    for (i = 1; i <= 3; i++)
        raw["primaryattachment" + i] = cacAttNum(l["p"], l["p_a" + i]);
    for (i = 1; i <= 2; i++)
        raw["secondaryattachment" + i] = cacAttNum(l["s"], l["s_a" + i]);
    foreach (g in strtok("primarygrenade,specialgrenade", ","))
    {
        n = 0;
        if (raw[g] != 0)
        {
            if (g == "primarygrenade") n = int(l["lethal_n"]);
            else n = int(l["tac_n"]);
        }
        raw[g + "count"] = n;
        for (i = 1; i <= 3; i++)
            raw[g + "status" + i] = int(i <= n);
    }
    return raw;
}

cacRawString(raw)
{
    str = "";
    foreach (k in getarraykeys(raw))
        if (raw[k] != 0)
            str += k + "=" + raw[k] + ",";
    return str;
}

// All five for BO2's Choose Class (dcac_cls0..4; only changed ones are sent)
cacSendClasses()
{
    if (!isdefined(self.dcac))
        return;
    self cacSeedDefaults();
    for (n = 0; n < 5; n++)
        self cacDvar("dcac_cls" + n, cacRawString(self cacRaw(n)));
}

cacFromBo2()
{
    l = self.dcac[self.dcac_cur];
    raw = self.dcac_raw;
    m = cacBo2Slots();
    foreach (k in getarraykeys(m))
        l[m[k]] = cacItemRef(raw[k]);
    for (i = 1; i <= 3; i++)
        l["p_a" + i] = cacAttRef(l["p"], raw["primaryattachment" + i]);
    for (i = 1; i <= 2; i++)
        l["s_a" + i] = cacAttRef(l["s"], raw["secondaryattachment" + i]);
    l["lethal_n"] = "" + int(raw["primarygrenadecount"]);
    l["tac_n"] = "" + int(raw["specialgrenadecount"]);
    self.dcac[self.dcac_cur] = l;
    self cacSave();
}

editClassBo2()
{
    self.dcac_raw = self cacRaw(self.dcac_cur);
    str = cacRawString(self.dcac_raw);
    self dlog("cls " + self.dcac_cur + " " + str);
    self cacDvar("dcac_cls", str);
    self cacDvar("dcac_clsnum", "" + self.dcac_cur);
    self cacSeq("cac");
    for (;;)
    {
        self waittill("menuresponse", menu, response);
        if (menu != "class")
            continue;
        if (response == "dcac_cacdone")
            return false;
        // Use This Class: the editor has closed itself
        if (response == "dcac_usethis")
        {
            self applyLoadout();
            return true;
        }
        if (response.size > 9 && getsubstr(response, 0, 9) == "dcac_set_")
        {
            t = strtok(getsubstr(response, 9), "_");
            if (t.size == 2)
            {
                self.dcac_raw[t[0]] = int(t[1]);
                self cacFromBo2();
            }
        }
    }
}

applyLoadout()
{
    self cacCleanup();
    self cacSanitize();
    self cacSetUse(self.dcac_cur);
    // BO2's own rule: right away only in the spawn grace period before any combat (no ammo refills),
    // else the hook gives it next spawn
    if (self.sessionstate == "playing" && isdefined(self.class) && level.ingraceperiod && !self.hasdonecombat)
    {
        self maps\mp\gametypes\_class::giveloadout(self.team, self.class);
        self maps\mp\killstreaks\_killstreaks::giveownedkillstreak();
        self iprintlnbold("^2Class " + (self.dcac_cur + 1) + " equipped");
    }
    else
        self iprintlnbold(game["strings"]["change_class"]);
}

// ---
// Map / Mode (ends the match and loads the pick through the rotation)

// Gametype settings are read every second by _globallogic, so limits change live.
// execgts resets them on every map, so they are re-applied.
applyMatchOptions()
{
    level endon("game_ended");
    wait 1;
    gt = level.gametype;
    if (getdvar("dcac_base_score_" + gt) == "")
        setdvar("dcac_base_score_" + gt, "" + getgametypesetting("scoreLimit"));
    if (getdvar("dcac_opt_timelimit") != "")
        setgametypesetting("timeLimit", getdvarfloat("dcac_opt_timelimit"));
    if (getdvar("dcac_opt_score") != "")
        setgametypesetting("scoreLimit", int(getdvarint("dcac_base_score_" + gt) * getdvarfloat("dcac_opt_score")));
}

matchModes()
{
    m = [];
    m["gt"] = strtok("tdm,dm,dom,conf,sd,koth,hq,ctf,dem,oneflag,gun,oic,shrp,sas", ",");
    m["name"] = strtok("Team Deathmatch,Free-for-All,Domination,Kill Confirmed,Search and Destroy,Hardpoint,Headquarters,Capture the Flag,Demolition,One Flag CTF,Gun Game,One in the Chamber,Sharpshooter,Sticks and Stones", ",");
    return m;
}

// The offline launcher passes the maps found in zone/all as dcac_maps; without it, the base maps.
// Packs as BO2 groups them: the original maps with Nuketown 2025, then the four DLC packs.
matchMaps()
{
    keys = strtok("mp_la,mp_dockside,mp_carrier,mp_drone,mp_express,mp_hijacked,mp_meltdown,mp_overflow,mp_nightclub,mp_raid,mp_slums,mp_village,mp_turbine,mp_socotra,mp_nuketown_2020,mp_downhill,mp_mirage,mp_hydro,mp_skate,mp_concert,mp_magma,mp_vertigo,mp_studio,mp_uplink,mp_bridge,mp_castaway,mp_paintball,mp_dig,mp_frostbite,mp_pod,mp_takeoff", ",");
    names = strtok("Aftermath,Cargo,Carrier,Drone,Express,Hijacked,Meltdown,Overflow,Plaza,Raid,Slums,Standoff,Turbine,Yemen,Nuketown 2025,Downhill,Mirage,Hydro,Grind,Encore,Magma,Vertigo,Studio,Uplink,Detour,Cove,Rush,Dig,Frost,Pod,Takeoff", ",");
    have = strtok(getdvar("dcac_maps"), ",");
    m = [];
    m["key"] = [];
    m["name"] = [];
    m["pack"] = [];
    m["pack_name"] = strtok("Original Maps,Revolution,Uprising,Vengeance,Apocalypse", ",");
    for (i = 0; i < keys.size; i++)
    {
        if (have.size > 0 && !isinarray(have, keys[i]))
            continue;
        if (have.size == 0 && i > 14)
            continue;
        m["key"][m["key"].size] = keys[i];
        m["name"][m["name"].size] = names[i];
        if (i < 15) m["pack"][m["pack"].size] = "0";
        else m["pack"][m["pack"].size] = "" + (1 + int((i - 15) / 4));
    }
    return m;
}

// Map packs first when DLC maps are installed, else the maps straight away
pickMap(maps, current)
{
    packs = [];
    foreach (p in maps["pack"])
        if (!isinarray(packs, p))
            packs[packs.size] = p;
    pack = maps["pack"][current];
    for (;;)
    {
        if (packs.size > 1)
        {
            names = [];
            foreach (p in packs)
                names[names.size] = maps["pack_name"][int(p)];
            r = self pickList("MAP PACK", names, indexOf(packs, pack));
            if (r == -1)
                return -1;
            pack = packs[r];
        }
        idx = [];
        names = [];
        for (i = 0; i < maps["key"].size; i++)
            if (maps["pack"][i] == pack)
            {
                idx[idx.size] = i;
                names[names.size] = maps["name"][i];
            }
        r = self pickList("MAP", names, indexOf(idx, current));
        if (r != -1)
            return idx[r];
        if (packs.size <= 1)
            return -1;
    }
}

indexOf(list, value)
{
    for (i = 0; i < list.size; i++)
        if (list[i] == value)
            return i;
    return 0;
}

scoreName(mult)
{
    if (mult == "0") return "Unlimited";
    if (mult == "0.5") return "Half";
    if (mult == "2") return "Double";
    return "Default";
}

// Returns true when a new match is loading and the menu closed
openMatchMenu()
{
    modes = matchModes();
    maps = matchMaps();
    mode = indexOf(modes["gt"], level.gametype);
    mapIndex = indexOf(maps["key"], getdvar("mapname"));
    time = getdvar("dcac_opt_timelimit");
    if (time == "") time = "" + getgametypesetting("timeLimit");
    score = getdvar("dcac_opt_score");
    if (score == "") score = "1";
    index = 0;

    for (;;)
    {
        items = [];
        items[0] = "Mode: " + modes["name"][mode];
        items[1] = "Map: " + maps["name"][mapIndex];
        if (time == "0") items[2] = "Time Limit: Unlimited";
        else items[2] = "Time Limit: " + time + " min";
        items[3] = "Score Limit: " + scoreName(score);
        items[4] = "Start Match";
        d = [];
        d[0] = "Which game mode to play next.";
        d[1] = "Which map to play next.";
        d[2] = "How long a match lasts.";
        d[3] = "How many points win the match.";
        d[4] = "Load mode and map. Limits alone apply instantly.";
        self.cac_descs = d;
        self.cac_startIndex = index;
        // map panel (deckopsmenu.lua): BO2's map picture + names for the pick, only on this screen
        self cacDvar("dcac_mpic", maps["key"][mapIndex]);
        self cacDvar("dcac_mname", maps["name"][mapIndex]);
        self cacDvar("dcac_mmode", modes["name"][mode]);
        r = self showMenu("MAP / MODE", items);
        self cacDvar("dcac_mpic", "");
        if (r == -1)
            return false;
        index = r;
        switch (r)
        {
            case 0:
                p = self pickList("MODE", modes["name"], mode);
                if (p != -1) mode = p;
                break;
            case 1:
                p = self pickMap(maps, mapIndex);
                if (p != -1) mapIndex = p;
                break;
            case 2:
                vals = strtok("0,5,10,15,20,30", ",");
                p = self pickList("TIME LIMIT", strtok("Unlimited,5 min,10 min,15 min,20 min,30 min", ","));
                if (p != -1) time = vals[p];
                break;
            case 3:
                // relative to the mode's gamesettings default, captured before any override
                vals = strtok("0,0.5,1,2", ",");
                p = self pickList("SCORE LIMIT", strtok("Unlimited,Half,Default,Double", ","));
                if (p != -1) score = vals[p];
                break;
            case 4:
                self startMatch(modes["gt"][mode], modes["name"][mode], maps["key"][mapIndex], maps["name"][mapIndex], time, score);
                return true;
        }
    }
}

startMatch(gt, gtName, map, mapName, time, score)
{
    setdvar("dcac_opt_timelimit", time);
    setdvar("dcac_opt_score", score);
    self cacCleanup();

    if (gt == level.gametype && map == getdvar("mapname"))
    {
        // only the limits changed: apply live, no restart
        level thread applyMatchOptions();
        self iprintlnbold("^2Match settings applied");
        return;
    }

    rot = "execgts " + gt + ".cfg map " + map;
    setdvar("sv_maprotation", rot);
    setdvar("sv_maprotationcurrent", rot);
    iprintlnbold("^2Loading ^7" + mapName + " ^2- ^7" + gtName);
    wait 2;
    exitlevel(0);
}

// ---
// Bot Warfare (BO2 version reads these dvars live; jump & dropshot applies when a bot spawns)

openBotMenu()
{
    index = 0;
    for (;;)
    {
        items = [];
        // bots_manage_fill counts the player too
        bots = getdvarint("bots_manage_fill") - 1;
        if (bots < 0) bots = 0;
        items[0] = "Bot Count: " + bots;
        items[1] = "Difficulty: " + botSkillName(botSkill());
        if (getdvar("bots_team") == "autoassign" || getdvar("bots_team") == "") items[2] = "Bot Team: Balanced";
        else items[2] = "Bot Team: All Enemies";
        items[3] = "Grenades: " + onOff(getdvarint("bots_play_nade"));
        items[4] = "Jump & Dropshot: " + onOff(getdvarint("bots_play_jumpdrop"));
        d = [];
        d[0] = "How many bots are in the match (0 to 12).";
        d[1] = "How well bots aim, move and react.";
        d[2] = "Balanced: bots on both sides. All Enemies: vs you.";
        d[3] = "Bots throw grenades and equipment.";
        d[4] = "Bots jump and go prone in gunfights (next spawn).";
        self.cac_descs = d;
        self.cac_startIndex = index;
        r = self showMenu("BOT WARFARE", items);
        if (r == -1)
            return;
        index = r;
        switch (r)
        {
            case 0:
                // sv_maxclients is 13 in the LAN config: 12 bots + the player (fill counts the player too)
                counts = strtok("0,2,4,6,8,10,12", ",");
                p = self pickList("BOT COUNT", counts);
                if (p != -1)
                {
                    fill = int(counts[p]);
                    if (fill > 0) fill++;
                    setdvar("bots_manage_fill", "" + fill);
                }
                break;
            case 1:
                names = [];
                for (i = 0; i < 4; i++) names[i] = botSkillName(i);
                p = self pickList("DIFFICULTY", names);
                if (p != -1) setdvar("bots_skill", "" + p);
                break;
            case 2:
                if (getdvar("bots_team") == "autoassign" || getdvar("bots_team") == "")
                {
                    // every bot on the team opposite the player
                    if (self.team == "axis") setdvar("bots_team", "allies");
                    else setdvar("bots_team", "axis");
                    setdvar("bots_team_force", "1");
                }
                else
                {
                    setdvar("bots_team", "autoassign");
                    setdvar("bots_team_force", "0");
                }
                break;
            case 3: botToggle("bots_play_nade"); break;
            case 4: botToggle("bots_play_jumpdrop"); break;
        }
    }
}

// Bot Warfare moves bots_skill into bot_difficulty within 1.5s
botSkill()
{
    if (getdvar("bots_skill") != "")
        return getdvarint("bots_skill");
    return getdvarint("bot_difficulty");
}

botSkillName(n)
{
    if (n <= 0) return "Easy";
    if (n == 1) return "Normal";
    if (n == 2) return "Hard";
    return "Veteran";
}

onOff(v)
{
    if (v) return "On";
    return "Off";
}

botToggle(dvar)
{
    if (getdvarint(dvar)) setdvar(dvar, "0");
    else setdvar(dvar, "1");
}

// Bots hold still while anyone has the menu open (BO2 bots have no bots_play_move, so they are frozen)
botsPause()
{
    if (!isdefined(level.dcac_menus))
        level.dcac_menus = 0;
    level.dcac_menus++;
    if (level.dcac_menus == 1)
        level thread botsHold();
}

botsResume()
{
    if (isdefined(level.dcac_menus) && level.dcac_menus > 0)
        level.dcac_menus--;
}

botsHold()
{
    level endon("game_ended");
    while (level.dcac_menus > 0)
    {
        foreach (p in level.players)
            if (p isBotPlayer())
                p freezecontrols(true);
        wait 0.25;
    }
    if (level.inprematchperiod)
        return;
    foreach (p in level.players)
        if (p isBotPlayer())
            p freezecontrols(false);
}

// ---
// Real menu (deckopsmenu, BO2 Lua): the server sends text as client dvars, only when it changed

cacDvar(name, value)
{
    if (!isdefined(self.dcac_sent)) self.dcac_sent = [];
    if (isdefined(self.dcac_sent[name]) && self.dcac_sent[name] == value)
        return;
    self.dcac_sent[name] = value;
    self setclientdvar(name, value);
}

// Freezing the player blocks Dpad and stick input on T6, so only stand still.
// disableweapons() is left out: the Dpad is a weapon switch on T6 and may be swallowed with it.
cacLock(on)
{
    if (on)
    {
        self.cac_speed = self getmovespeedscale();
        self setmovespeedscale(0);
    }
    else
    {
        self setmovespeedscale(self.cac_speed);
        self.cac_speed = undefined;
    }
    self allowjump(!on);
    self allowsprint(!on);
}

// Last dvar of every screen: a new id makes the open menu redraw; the state after "|" opens or closes it
cacSeq(state)
{
    self cacDvar("dcac_seq", gettime() + "_" + randomint(1000000) + "|" + state);
}

// Class panel: BO2's class preview comes in the next build
cacUpdatePanel()
{
}

// self.cac_startIndex / self.cac_descs are one-shot inputs (cursor row, row descriptions)
showMenu(title, items)
{
    self endon("disconnect");
    self endon("death");

    if (!isdefined(self.cac_ui))
    {
        botsPause();
        self cacLock(true);
        self.cac_ui = true;
    }

    menuSize = items.size;
    if (menuSize > 15) menuSize = 15;

    index = 0;
    if (isdefined(self.cac_startIndex))
    {
        if (self.cac_startIndex < menuSize) index = self.cac_startIndex;
        self.cac_startIndex = undefined;
    }
    descs = self.cac_descs;
    self.cac_descs = undefined;

    self cacDvar("dcac_title", title);
    for (i = 0; i < 15; i++)
    {
        r = "";
        d = "";
        if (i < menuSize) r = items[i];
        if (isdefined(descs) && isdefined(descs[i])) d = descs[i];
        self cacDvar("dcac_r" + i, r);
        self cacDvar("dcac_d" + i, d);
    }
    self cacDvar("dcac_start", "" + index);
    self cacUpdatePanel();
    self cacSeq("open");
    // opened once; later screens only change the dvars
    if (!isdefined(self.cac_menu))
    {
        self.cac_menu = true;
        self openmenu("deckopsmenu");
    }

    for (;;)
    {
        self waittill("menuresponse", menu, response);
        if (menu != "class")
            continue;
        self dlog("input " + response);
        if (response == "dcac_back")
            return -1;
        if (response.size > 10 && getsubstr(response, 0, 10) == "dcac_pick_")
        {
            i = int(getsubstr(response, 10));
            if (i >= 0 && i < menuSize)
                return i;
        }
    }
}

