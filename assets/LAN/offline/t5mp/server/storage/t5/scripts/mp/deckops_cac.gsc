/*
    DeckOps In-Game Settings v1.0 (T5 / Black Ops MP, offline LAN server)
    ======================================================================
    Server-side GSC for the DeckOps offline server (Plutonium T5, -lan -dedicated).
    Lives in: storage/t5/scripts/mp/deckops_cac.gsc

    Ported from the DeckOps WaW menu (hub, Map / Mode, Bot Warfare, HUD) with an MW3-style class editor:
        - Open: CHOOSE CLASS in the in-game menu (hub: Class Editor, Choose Class, Map / Mode, Bot Warfare)
        - Five DeckOps classes, everything unlocked, perks always Pro (offline has no challenges)
        - Loadouts go through BO1's own Copycat path: giveLoadout gives self.pers["copycat_loadout"] before
          any custom class read. Feeding the custom class readers instead drops the player ("Your stats could
          not be validated"), ranked or not (PC, 2026-10-09). Real player stats are never written.
        - Item lists and names: dcacCatalog(), generated by gen_catalog.py from BO1's own tables and strings
        - Classes are saved in server dvars (map changes) and scriptdata/deckops_bo1_<guid>.txt (restarts)

    Controls:
        - Scroll: Dpad Up / Down (+actionslot 1/2), W / S
        - Select: Jump (A / Space) or Reload (X)
        - Back: Stance (B) or crouch (C)

    Credits: Divity (k) original in-game CAC concept, DeckOps Community
*/

#include common_scripts\utility;
#include maps\mp\_utility;
#include maps\mp\gametypes\_hud_util;

init()
{
    precacheShader("white");
    // mods/mp_deckops_offline/mod.ff: the list every DeckOps screen is shown in
    precacheMenu("dcac_list");

    // Stock clears the Copycat struct on death and at the end of an unused killcam, and makes a
    // pistol sidearm the spawn weapon; DeckOps classes keep theirs and spawn with the primary
    replaceFunc(maps\mp\gametypes\_copycat::copycat_clone_loadout, ::dcacCloneLoadout);
    replaceFunc(maps\mp\gametypes\_copycat::copycat_button_think, ::dcacButtonThink);
    replaceFunc(maps\mp\gametypes\_copycat::copycat_give_sidearm_weapon, ::dcacGiveSidearm);

    level.dcac = dcacCatalog();
    // Weapon pictures for the class panel (shaders must be precached before the first spawn)
    lists = strTok("primary_image,secondary_image,specialty1_image,specialty2_image,specialty3_image,primarygrenade_image,specialgrenade_image,equipment_image,att_image", ",");
    for (l = 0; l < lists.size; l++)
        for (i = 0; i < level.dcac[lists[l]].size; i++)
            if (level.dcac[lists[l]][i] != "weapon_missing_image")
                precacheShader(level.dcac[lists[l]][i]);
    level thread onPlayerConnect();
    level thread applyMatchOptions();
}

onPlayerConnect()
{
    for (;;)
    {
        level waittill("connected", player);
        // T5 has no isBot(), and Bot Warfare sets pers["isBot"] only after "connected": bots have GUID 0
        if ((player getGuid() + "") == "0")
            continue;
        player.dcac_guid = player getGuid() + "";
        player dlog("connected guid=" + player.dcac_guid);
        player initCac();
        player cacArm();
        player thread watchForMenuOpen();
        player thread watchDeath();
        player thread watchSpawn();
    }
}

// ============================================================
// DEATH WATCHER (close the menu if the player dies with it open)
// ============================================================

watchDeath()
{
    self endon("disconnect");
    for (;;)
    {
        self waittill("death");
        self cacCleanup();
    }
}

cacCleanup()
{
    if (isDefined(self.cac_ui))
    {
        self dlog("menu closed");
        self botsResume();
        self closeMenu();
        self closeInGameMenu();
    }
    self.cac_ui = undefined;
    self.cac_open = false;
}

// Test builds: +set dcac_debug 1 logs the menu flow to games_mp.log
dlog(msg)
{
    if (getDvarInt("dcac_debug"))
        logprint("DCAC;" + self.name + ";" + msg + "\n");
}

// ============================================================
// CLASS DATA
// One class = item references in this order, "none" for an empty attachment
// ============================================================

cacFields()
{
    return strTok("primary,patt1,patt2,secondary,satt,lethal,tactical,equipment,perk1,perk2,perk3,ks1,ks2,ks3", ",");
}

defaultClass()
{
    c = [];
    c["primary"] = "m16"; c["patt1"] = "none"; c["patt2"] = "none";
    c["secondary"] = "m1911"; c["satt"] = "none";
    c["lethal"] = "frag_grenade"; c["tactical"] = "willy_pete"; c["equipment"] = "claymore";
    c["perk1"] = "specialty_movefaster"; c["perk2"] = "specialty_bulletaccuracy"; c["perk3"] = "specialty_longersprint";
    c["ks1"] = "killstreak_spyplane"; c["ks2"] = "killstreak_napalm"; c["ks3"] = "killstreak_helicopter_comlink";
    return c;
}

initCac()
{
    self cacReadFile();
    self.dcac = [];
    saved = strTok(getDvar("dcac_" + self.dcac_guid), ";");
    fields = cacFields();
    for (n = 0; n < 5; n++)
    {
        c = defaultClass();
        if (isDefined(saved[n]))
        {
            vals = strTok(saved[n], ",");
            if (vals.size == fields.size)
                for (i = 0; i < fields.size; i++)
                    c[fields[i]] = vals[i];
        }
        self.dcac[n] = c;
    }
    // The DeckOps class in use: a dvar for map changes, the save file's 6th entry after a restart
    self.dcac_use = undefined;
    use = getDvar("dcac_use_" + self.dcac_guid);
    if (use == "" && isDefined(saved[5])) use = saved[5];
    if (use != "" && use != "-")
        self.dcac_use = int(use);
}

cacSave()
{
    fields = cacFields();
    str = "";
    for (n = 0; n < 5; n++)
    {
        if (n > 0) str += ";";
        for (i = 0; i < fields.size; i++)
        {
            if (i > 0) str += ",";
            str += self.dcac[n][fields[i]];
        }
    }
    if (isDefined(self.dcac_use)) str += ";" + self.dcac_use;
    else str += ";-";
    setDvar("dcac_" + self.dcac_guid, str);
    f = fs_fopen(self cacFile(), "write");
    fs_writeline(f, str);
    fs_fclose(f);
}

cacFile()
{
    return "scriptdata/deckops_bo1_" + self.dcac_guid + ".txt";
}

// Fresh server (no dvar yet): load the classes saved by an earlier session
cacReadFile()
{
    if (getDvar("dcac_" + self.dcac_guid) != "" || !fs_testfile(self cacFile()))
        return;
    f = fs_fopen(self cacFile(), "read");
    line = fs_readline(f);
    fs_fclose(f);
    if (isDefined(line) && strTok(line, "\r\n").size == 1)
        setDvar("dcac_" + self.dcac_guid, strTok(line, "\r\n")[0]);
}

// ============================================================
// LOADOUT (BO1's Copycat struct, given by _class::giveLoadout)
// ============================================================

catIndex(list, ref)
{
    for (i = 0; i < level.dcac[list].size; i++)
        if (level.dcac[list][i] == ref)
            return i;
    return -1;
}

catName(list, ref)
{
    i = catIndex(list, ref);
    if (i == -1)
        return "None";
    return level.dcac[list + "_name"][i];
}

attName(ref)
{
    if (ref == "none")
        return "No Attachment";
    return catName("att", ref);
}

attPos(ref)
{
    return level.dcac["att_pos"][catIndex("att", ref)];
}

// The game's weapon names: <ref>_<top>_<bottom>_<trigger>_<muzzle>_mp, Dual Wield as <ref>dw_mp (_class getFullWeaponName)
weaponFullName(ref, a1, a2)
{
    if (a1 == "dw")
        return ref + "dw_mp";
    parts = "";
    pos = strTok("top,bottom,trigger,muzzle", ",");
    for (p = 0; p < pos.size; p++)
    {
        if (a1 != "none" && attPos(a1) == pos[p]) parts += a1 + "_";
        if (a2 != "none" && attPos(a2) == pos[p]) parts += a2 + "_";
    }
    return ref + "_" + parts + "mp";
}

hasWarlord(c)
{
    return c["perk2"] == "specialty_twoattach";
}

cacLoadout(n)
{
    c = self.dcac[n];
    l = [];
    // A pair saved before attPairs knew the game's weapons would give no primary
    if (!attPairs(c["patt1"], c["patt2"])) c["patt2"] = "none";
    l["primary"] = weaponFullName(c["primary"], c["patt1"], c["patt2"]);
    l["weapon_options"] = 0;
    l["secondary"] = weaponFullName(c["secondary"], c["satt"], "none");
    l["grenades"] = c["lethal"] + "_mp";
    l["grenades_count"] = int(level.dcac["primarygrenade_count"][catIndex("primarygrenade", c["lethal"])]);
    // Warlord Pro: two lethal grenades
    if (hasWarlord(c)) l["grenades_count"] += 1;
    l["specialgrenades"] = c["tactical"] + "_mp";
    l["specialgrenades_count"] = int(level.dcac["specialgrenade_count"][catIndex("specialgrenade", c["tactical"])]);
    l["inventory"] = c["equipment"] + "_mp";
    l["inventory_count"] = int(level.dcac["equipment_count"][catIndex("equipment", c["equipment"])]);
    l["specialties"] = [];
    for (p = 1; p <= 3; p++)
    {
        list = "specialty" + p;
        specs = strTok(level.dcac[list + "_specs"][catIndex(list, c["perk" + p])], "|");
        for (i = 0; i < specs.size; i++)
        {
            s = spawnStruct();
            s.name = specs[i];
            s.group = "specialty";
            l["specialties"][l["specialties"].size] = s;
        }
        // The spawn HUD draws specialty1-3 as pictures (stock fills them with the perk's image column):
        // a specialty name there showed white blocks (PC 2026-10-09)
        l["specialty" + p] = level.dcac[list + "_image"][catIndex(list, c["perk" + p])];
    }
    l["killstreak1"] = c["ks1"];
    l["killstreak2"] = c["ks2"];
    l["killstreak3"] = c["ks3"];
    l["in_use"] = true;
    return l;
}

// The next spawn gives the DeckOps class in use (none: stock)
cacArm()
{
    if (isDefined(self.dcac_use))
        self.pers["copycat_loadout"] = self cacLoadout(self.dcac_use);
}

watchSpawn()
{
    self endon("disconnect");
    for (;;)
    {
        self waittill("spawned_player");
        // given (in_use now false): arm it again for the next spawn
        self cacArm();
    }
}

// Make class n current: right away in the spawn grace period before any combat (BO1's own rule,
// so the menu can't refill ammo), else next spawn
useClass(n)
{
    self.dcac_use = n;
    setDvar("dcac_use_" + self.dcac_guid, "" + n);
    self cacSave();
    self cacArm();
    if (self.sessionstate != "playing")
        return;
    if (level.inGracePeriod && (!isDefined(self.hasDoneCombat) || !self.hasDoneCombat))
    {
        self maps\mp\gametypes\_class::giveLoadout(self.pers["team"], self.class);
        self cacArm();
        self iPrintLnBold("^2Custom Class " + (n + 1) + " equipped");
    }
    else
        self DisplayGameModeMessage(game["strings"]["change_class"], "uin_alert_slideout");
}

stopUsingClass()
{
    self.dcac_use = undefined;
    setDvar("dcac_use_" + self.dcac_guid, "-");
    self cacSave();
    self.pers["copycat_loadout"] = undefined;
}

// Copycat replacements: DeckOps players keep their struct, everyone else gets stock behaviour

dcacCloneLoadout(attacker)
{
    if (isDefined(self.dcac_use))
    {
        self cacArm();
        return;
    }
    self.pers["copycat_loadout"] = undefined;
    if (!self hasPerk("specialty_copycat") || !self DeathStreakActive())
        return;
    if (attacker.curclass == "copycat" || !isSubStr(attacker.curclass, "CLASS_CUSTOM"))
        return;
    self.pers["copycat_loadout"] = attacker.custom_class[attacker.class_num];
    self.pers["copycat_loadout"]["in_use"] = false;
    self.pers["copycat_loadout"]["killstreak1"] = self.killstreak[0];
    self.pers["copycat_loadout"]["killstreak2"] = self.killstreak[1];
    self.pers["copycat_loadout"]["killstreak3"] = self.killstreak[2];
    self maps\mp\gametypes\_copycat::copycat_remove_deathstreaks();
}

dcacButtonThink()
{
    if (isDefined(self.dcac_use) || !isDefined(self.pers["copycat_loadout"]))
        return;
    icon = self maps\mp\gametypes\_copycat::copycat_button_create();
    text = self maps\mp\gametypes\_copycat::copycat_text_create();
    self thread maps\mp\gametypes\_copycat::copycat_button_press();
    event = self waittill_any_return("disconnect", "end_killcam", "abort_killcam", "copycat_used");
    if (event == "copycat_used")
        self.pers["copycat_loadout"]["in_use"] = true;
    else
        self.pers["copycat_loadout"] = undefined;
    icon destroy();
    text destroy();
}

dcacGiveSidearm()
{
    sidearm = self.pers["copycat_loadout"]["secondary"];
    self giveWeapon(sidearm);
    if (self maps\mp\gametypes\_class::cac_hasSpecialty("specialty_extraammo"))
        self giveMaxAmmo(sidearm);
    // Stock: a pistol is the spawn weapon (no first raise). DeckOps classes spawn with the primary.
    if (!isDefined(self.dcac_use) && maps\mp\gametypes\_weapons::isPistol(sidearm))
        self setSpawnWeapon(sidearm);
}

// ============================================================
// MENU OPEN
// ============================================================

watchForMenuOpen()
{
    self endon("disconnect");

    self.cac_open = false;

    self notifyOnPlayerCommand("cac_up", "+forward");
    self notifyOnPlayerCommand("cac_up", "+actionslot 1");
    self notifyOnPlayerCommand("cac_down", "+back");
    self notifyOnPlayerCommand("cac_down", "+actionslot 2");
    self notifyOnPlayerCommand("cac_select", "+gostand");
    self notifyOnPlayerCommand("cac_select", "+usereload");
    self notifyOnPlayerCommand("cac_select", "+activate");
    // B only: aim buttons as Back closed the menu by accident
    self notifyOnPlayerCommand("cac_back", "+stance");
    // C: crouch is gocrouch (WaW) or togglecrouch (BO1, MW3), only BO2 binds it to +stance
    self notifyOnPlayerCommand("cac_back", "gocrouch");
    self notifyOnPlayerCommand("cac_back", "togglecrouch");

    // CHOOSE CLASS in the in-game menu sends ("class", "changeclass_marines"/"changeclass_opfor"):
    // close the stock list it opens and show the hub instead (the forced pick on joining stays stock)
    for (;;)
    {
        self waittill("menuresponse", menu, response);
        self dlog("menuresponse " + menu + " " + response);
        if (menu == "class" && isSubStr(response, "changeclass"))
            self thread openFromChooseClass();
        // After the team pick BO1 opens its class list: show the DeckOps classes in its place
        else if (menu == game["menu_team"] && response != "back" && response != "spectator")
            self thread openJoinPicker();
        // BO1's own class list (mod.ff changeclass): Custom Class N is DeckOps class N, a default class replaces it
        else if (menu == "changeclass" && isDefined(self.dcac_stockpick))
        {
            from = self.dcac_stockpick;
            self.dcac_stockpick = undefined;
            if (getSubStr(response, 0, 6) == "custom")
                self useClass(int(getSubStr(response, 6, 7)) - 1);
            // B goes back to the screen that opened the list, like our own screens (stock B only closes it)
            else if (response == "back" && from == "join")
                self thread openJoinPicker();
            else if (response == "back")
                self thread openFromChooseClass(1);
            else
                self stopUsingClass();
        }
    }
}

openFromChooseClass(index)
{
    self endon("disconnect");
    wait 0.05;
    self closeMenu();
    self closeInGameMenu();
    if (self.cac_open)
    {
        self notify("dcac_reset");
        self cacCleanup();
    }
    if (self.sessionstate == "playing")
    {
        self.cac_open = true;
        if (isDefined(index)) self.cac_startIndex = index;
        self thread openHubMenu();
    }
}

// Class pick on joining (and after a team change), like BO1's own: the five DeckOps classes, then Default
// Classes for BO1's list. Our HUD menu can't be used while spectating (nothing reached it after the team pick,
// PC 2026-10-09), so the player spawns first with a default class and picks over it, before any combat.
openJoinPicker()
{
    self endon("disconnect");
    wait 0.05;
    self closeMenu();
    self closeInGameMenu();
    if (self.cac_open)
    {
        self notify("dcac_reset");
        self cacCleanup();
    }
    // a later reset (Choose Class, team change) ends every screen of this flow, not just its showMenu wait
    self endon("dcac_reset");
    self.cac_open = true;
    if (self.sessionstate != "playing")
    {
        self maps\mp\gametypes\_globallogic_ui::menuClass("smg_mp,0");
        for (i = 0; i < 100 && self.sessionstate != "playing"; i++)
            wait 0.1;
        wait 0.2;
    }
    for (;;)
    {
        items = [];
        for (n = 0; n < 5; n++)
            items[n] = "Custom Class " + (n + 1) + ": " + catName("primary", self.dcac[n]["primary"]);
        items[5] = "Default Classes";
        self.cac_panel = undefined;
        if (isDefined(self.dcac_use)) self.cac_startIndex = self.dcac_use;
        r = self showMenu("CHOOSE CLASS", items);
        // a class has to be picked, as in BO1's own list
        if (r == -1)
            continue;
        self cacCleanup();
        if (r == 5)
        {
            self stopUsingClass();
            self.dcac_stockpick = "join";
            self openMenu(game["menu_changeclass"]);
            return;
        }
        self.dcac_use = r;
        setDvar("dcac_use_" + self.dcac_guid, "" + r);
        self cacSave();
        self cacArm();
        // Just spawned and held in the menu: given now, unless the player already fought
        if (!isDefined(self.hasDoneCombat) || !self.hasDoneCombat)
        {
            self maps\mp\gametypes\_class::giveLoadout(self.pers["team"], self.class);
            self cacArm();
        }
        else
            self DisplayGameModeMessage(game["strings"]["change_class"], "uin_alert_slideout");
        return;
    }
}

// ============================================================
// HUB
// ============================================================

openHubMenu()
{
    self endon("disconnect");
    self endon("death");
    self endon("dcac_reset");

    items = [];
    items[0] = "Class Editor";
    items[1] = "Choose Class";
    items[2] = "Map / Mode";
    items[3] = "Bot Warfare";

    d = [];
    d[0] = "Build and use your five custom classes.";
    d[1] = "Use one of Black Ops' own classes instead.";
    d[2] = "Change the mode, the map and the match limits.";
    d[3] = "How many bots, how tough, and how they play.";
    self.cac_descs = d;
    result = self showMenu("SETTINGS", items);
    switch (result)
    {
        case 0: self thread openClassList(); break;
        case 1: self thread openStockClassList(); break;
        case 2: self thread openMatchMenu(); break;
        case 3: self thread openBotMenu(); break;
        default: self cacCleanup(); break;
    }
}

openStockClassList()
{
    self endon("disconnect");
    self cacCleanup();
    self.dcac_stockpick = "hub";
    self openMenu(game["menu_changeclass"]);
}

// ============================================================
// CLASS EDITOR
// ============================================================

openClassList(index)
{
    self endon("disconnect");
    self endon("death");
    self endon("dcac_reset");

    if (isDefined(index)) self.cac_startIndex = index;
    items = [];
    for (n = 0; n < 5; n++)
    {
        items[n] = "Custom Class " + (n + 1) + ": " + catName("primary", self.dcac[n]["primary"]);
        if (isDefined(self.dcac_use) && self.dcac_use == n)
            items[n] += " (in use)";
    }
    self.cac_panel = undefined;
    result = self showMenu("CLASS EDITOR", items);
    if (result == -1) { self thread openHubMenu(); return; }
    self thread openClassEdit(result);
}

attLine(a1, a2)
{
    if (a2 == "none")
        return attName(a1);
    return attName(a1) + " + " + attName(a2);
}

streakLine(c)
{
    return catName("killstreak", c["ks1"]) + ", " + catName("killstreak", c["ks2"]) + ", " + catName("killstreak", c["ks3"]);
}

openClassEdit(n, index)
{
    self endon("disconnect");
    self endon("death");
    self endon("dcac_reset");

    if (isDefined(index)) self.cac_startIndex = index;
    c = self.dcac[n];
    self.cac_panel = n;

    items = [];
    items[0] = "Primary: " + catName("primary", c["primary"]);
    items[1] = "Attachments: " + attLine(c["patt1"], c["patt2"]);
    items[2] = "Secondary: " + catName("secondary", c["secondary"]);
    items[3] = "Secondary Attachment: " + attName(c["satt"]);
    items[4] = "Lethal: " + catName("primarygrenade", c["lethal"]);
    items[5] = "Tactical: " + catName("specialgrenade", c["tactical"]);
    items[6] = "Equipment: " + catName("equipment", c["equipment"]);
    items[7] = "Perk 1: " + catName("specialty1", c["perk1"]);
    items[8] = "Perk 2: " + catName("specialty2", c["perk2"]);
    items[9] = "Perk 3: " + catName("specialty3", c["perk3"]);
    items[10] = "Killstreaks";
    items[11] = "Use This Class";

    d = [];
    d[1] = "A second attachment needs Warlord in Perk 2.";
    d[8] = "Warlord Pro: two attachments, two lethal grenades.";
    d[10] = streakLine(c);
    d[11] = "Switch to this class now, or on your next spawn.";
    self.cac_descs = d;
    result = self showMenu("CUSTOM CLASS " + (n + 1), items);
    switch (result)
    {
        case 0: self thread pickWeapon(n, "primary", 0); break;
        case 1: self thread pickAttachments(n); break;
        case 2: self thread pickWeapon(n, "secondary", 2); break;
        case 3: self thread pickSecondaryAttachment(n); break;
        case 4: self thread pickFromCatalog(n, "lethal", "primarygrenade", 4); break;
        case 5: self thread pickFromCatalog(n, "tactical", "specialgrenade", 5); break;
        case 6: self thread pickFromCatalog(n, "equipment", "equipment", 6); break;
        case 7: self thread pickFromCatalog(n, "perk1", "specialty1", 7); break;
        case 8: self thread pickFromCatalog(n, "perk2", "specialty2", 8); break;
        case 9: self thread pickFromCatalog(n, "perk3", "specialty3", 9); break;
        case 10: self thread openStreaks(n); break;
        case 11:
            self useClass(n);
            self cacCleanup();
            break;
        default: self thread openClassList(n); break;
    }
}

// One change: fix up what BO1 wouldn't accept, save, and re-arm a class in use
setField(n, field, value)
{
    c = self.dcac[n];
    c[field] = value;
    if (field == "primary") { c["patt1"] = "none"; c["patt2"] = "none"; }
    if (field == "secondary") c["satt"] = "none";
    // Warlord gone: the second attachment goes
    if (!hasWarlord(c)) c["patt2"] = "none";
    self.dcac[n] = c;
    self cacSave();
    if (isDefined(self.dcac_use) && self.dcac_use == n)
        self cacArm();
}

pickFromCatalog(n, field, list, row)
{
    self endon("disconnect");
    self endon("death");
    self endon("dcac_reset");

    result = self pickItem(level.dcac[list + "_name"], catIndex(list, self.dcac[n][field]));
    if (result != -1)
        self setField(n, field, level.dcac[list][result]);
    self thread openClassEdit(n, row);
}

// Category first, then the weapons in it (as in Create-a-Class); Back from the weapons returns to the categories
pickWeapon(n, slot, row)
{
    self endon("disconnect");
    self endon("death");
    self endon("dcac_reset");

    cur = catIndex(slot, self.dcac[n][slot]);
    cat = indexOf(level.dcac[slot + "_cats"], level.dcac[slot + "_group"][cur]);
    for (;;)
    {
        cat = self pickItem(level.dcac[slot + "_cats_name"], cat);
        if (cat == -1)
            break;
        keys = [];
        names = [];
        for (i = 0; i < level.dcac[slot].size; i++)
            if (level.dcac[slot + "_group"][i] == level.dcac[slot + "_cats"][cat])
            {
                keys[keys.size] = level.dcac[slot][i];
                names[names.size] = level.dcac[slot + "_name"][i];
            }
        r = self pickItem(names, indexOf(keys, self.dcac[n][slot]));
        if (r != -1)
        {
            self setField(n, slot, keys[r]);
            break;
        }
    }
    self thread openClassEdit(n, row);
}

// Attachments a weapon takes (statstable column 8), "none" first
weaponAtts(list, ref)
{
    atts = [];
    atts[0] = "none";
    i = catIndex(list, ref);
    if (i == -1 || level.dcac[list + "_atts"][i] == "-")
        return atts;
    have = strTok(level.dcac[list + "_atts"][i], "|");
    for (j = 0; j < have.size; j++)
        atts[atts.size] = have[j];
    return atts;
}

// Second attachment: one the first lists as a partner (attachmenttable column 11) in another slot of the
// weapon name: the table pairs Rapid Fire with Extended / Dual Mag, but the game has no such weapon (self-test 10-14)
attPairs(a1, a2)
{
    if (a1 == "none" || a2 == "none")
        return false;
    pairs = level.dcac["att_pairs"][catIndex("att", a1)];
    if (pairs == "-" || !isSubStr("|" + pairs + "|", "|" + a2 + "|"))
        return false;
    return attPos(a1) != attPos(a2);
}

pickAttachments(n)
{
    self endon("disconnect");
    self endon("death");
    self endon("dcac_reset");

    c = self.dcac[n];
    atts = weaponAtts("primary", c["primary"]);
    names = [];
    for (i = 0; i < atts.size; i++)
        names[i] = attName(atts[i]);
    result = self pickItem(names, indexOf(atts, c["patt1"]));
    if (result == -1) { self thread openClassEdit(n, 1); return; }
    self setField(n, "patt1", atts[result]);
    if (!attPairs(atts[result], self.dcac[n]["patt2"]))
        self setField(n, "patt2", "none");

    // Warlord: a second attachment that pairs with the first
    if (atts[result] != "none" && hasWarlord(self.dcac[n]))
    {
        first = atts[result];
        second = [];
        second[0] = "none";
        for (i = 1; i < atts.size; i++)
            if (attPairs(first, atts[i]))
                second[second.size] = atts[i];
        if (second.size > 1)
        {
            names = [];
            for (i = 0; i < second.size; i++)
                names[i] = attName(second[i]);
            r = self pickItem(names, indexOf(second, self.dcac[n]["patt2"]));
            if (r != -1)
                self setField(n, "patt2", second[r]);
        }
    }
    self thread openClassEdit(n, 1);
}

pickSecondaryAttachment(n)
{
    self endon("disconnect");
    self endon("death");
    self endon("dcac_reset");

    atts = weaponAtts("secondary", self.dcac[n]["secondary"]);
    if (atts.size > 1)
    {
        names = [];
        for (i = 0; i < atts.size; i++)
            names[i] = attName(atts[i]);
        result = self pickItem(names, indexOf(atts, self.dcac[n]["satt"]));
        if (result != -1)
            self setField(n, "satt", atts[result]);
    }
    self thread openClassEdit(n, 3);
}

openStreaks(n, index)
{
    self endon("disconnect");
    self endon("death");
    self endon("dcac_reset");

    if (isDefined(index)) self.cac_startIndex = index;
    c = self.dcac[n];
    items = [];
    for (k = 1; k <= 3; k++)
    {
        i = catIndex("killstreak", c["ks" + k]);
        items[k - 1] = "Killstreak " + k + ": " + level.dcac["killstreak_name"][i] + " (" + level.dcac["killstreak_kills"][i] + ")";
    }
    d = [];
    d[0] = "Kills needed in brackets. Three different streaks.";
    self.cac_descs = d;
    result = self showMenu("KILLSTREAKS", items);
    if (result == -1) { self thread openClassEdit(n, 10); return; }

    field = "ks" + (result + 1);
    // the other two slots' streaks can't be picked twice
    keys = [];
    names = [];
    for (i = 0; i < level.dcac["killstreak"].size; i++)
    {
        ks = level.dcac["killstreak"][i];
        taken = false;
        for (k = 1; k <= 3; k++)
            if ("ks" + k != field && c["ks" + k] == ks)
                taken = true;
        if (taken) continue;
        keys[keys.size] = ks;
        names[names.size] = level.dcac["killstreak_name"][i] + " (" + level.dcac["killstreak_kills"][i] + ")";
    }
    r = self pickItem(names, indexOf(keys, c[field]));
    if (r != -1)
        self setField(n, field, keys[r]);
    self thread openStreaks(n, result);
}

// Paged list, returns the picked index or -1. 15 rows fit above the prompt, so every Create-a-Class list
// fits on one page (Ray: avoid More); only a longer list pages with More
pickItem(names, current, maps)
{
    self endon("disconnect");
    self endon("death");
    self endon("dcac_reset");

    page = 0;
    if (current > 0) page = int(current / 14);
    for (;;)
    {
        if (names.size <= 15) first = 0;
        else first = page * 14;
        rows = [];
        per = 14;
        if (names.size <= 15) per = 15;
        for (i = first; i < names.size && i < first + per; i++)
            rows[rows.size] = names[i];
        more = first + per < names.size;
        if (more) rows[rows.size] = "More";
        else if (page > 0) rows[rows.size] = "Back to Start";
        if (current >= first && current < first + per) self.cac_startIndex = current - first;
        if (isDefined(maps))
        {
            m = [];
            for (i = first; i < names.size && i < first + per; i++)
                if (isDefined(maps[i])) m[m.size] = maps[i];
            self.cac_maps = m;
        }
        result = self showMenu("CHOOSE", rows);
        if (result == -1)
            return -1;
        if (first + result < names.size && result < per)
            return first + result;
        if (more) page++;
        else page = 0;
    }
}

indexOf(list, value)
{
    for (i = 0; i < list.size; i++)
        if (list[i] == value)
            return i;
    return 0;
}

// ============================================================
// MAP / MODE (ends the match and loads the pick through the rotation)
// ============================================================

// Time and score limits are scr_<gametype>_* dvars the match logic keeps reading, so they change
// live; the gametype resets them on every map, so they are re-applied
applyMatchOptions()
{
    level endon("game_ended");
    wait 1;
    gt = level.gameType;
    if (getDvar("dcac_base_score_" + gt) == "")
        setDvar("dcac_base_score_" + gt, "" + getDvarInt("scr_" + gt + "_scorelimit"));
    if (getDvar("dcac_opt_timelimit") != "")
        setDvar("scr_" + gt + "_timelimit", getDvar("dcac_opt_timelimit"));
    if (getDvar("dcac_opt_score") != "")
        setDvar("scr_" + gt + "_scorelimit", "" + int(getDvarInt("dcac_base_score_" + gt) * getDvarFloat("dcac_opt_score")));
}

// dcac_maps (set by the offline script) lists the installed maps; DLC maps may be missing
matchMaps()
{
    have = getDvar("dcac_maps");
    m = [];
    m["key"] = [];
    m["name"] = [];
    m["pack"] = [];
    for (i = 0; i < level.dcac["map"].size; i++)
        if (have == "" || isSubStr("," + have + ",", "," + level.dcac["map"][i] + ","))
        {
            m["key"][m["key"].size] = level.dcac["map"][i];
            m["name"][m["name"].size] = level.dcac["map_name"][i];
            m["pack"][m["pack"].size] = level.dcac["map_pack"][i];
        }
    return m;
}

openMatchMenu(index)
{
    self endon("disconnect");
    self endon("death");
    self endon("dcac_reset");

    if (isDefined(index)) self.cac_startIndex = index;

    modes = level.dcac["mode"];
    maps = matchMaps();
    if (!isDefined(self.mm_mode))
    {
        self.mm_mode = indexOf(modes, level.gameType);
        self.mm_map = indexOf(maps["key"], getDvar("mapname"));
        self.mm_time = getDvar("dcac_opt_timelimit");
        if (self.mm_time == "") self.mm_time = "" + getDvarInt("scr_" + level.gameType + "_timelimit");
        self.mm_score = getDvar("dcac_opt_score");
        if (self.mm_score == "") self.mm_score = "1";
    }

    items = [];
    items[0] = "Mode: " + level.dcac["mode_name"][self.mm_mode];
    items[1] = "Map: " + maps["name"][self.mm_map];
    if (self.mm_time == "0") items[2] = "Time Limit: Unlimited";
    else items[2] = "Time Limit: " + self.mm_time + " min";
    items[3] = "Score Limit: " + scoreName(self.mm_score);
    items[4] = "Start Match";

    d = [];
    d[0] = "Which game mode to play next.";
    d[1] = "Which map to play next.";
    d[2] = "How long a match lasts.";
    d[3] = "How many points win the match.";
    d[4] = "Load mode and map. Limits alone apply instantly.";
    self.cac_descs = d;
    self.cac_panel = undefined;
    self.mm_pic = oneMap(maps["key"][self.mm_map]);
    self.mm_cap = maps["name"][self.mm_map];
    self.cac_maps = self.mm_pic;
    self.cac_mapcap = self.mm_cap;
    result = self showMenu("MAP / MODE", items);
    switch (result)
    {
        case 0:
            self.cac_mapcap = self.mm_cap;
            r = self pickItem(level.dcac["mode_name"], self.mm_mode, self.mm_pic);
            if (r != -1) self.mm_mode = r;
            self thread openMatchMenu(0);
            break;
        case 1:
            r = self pickMap(maps, self.mm_map);
            if (r != -1) self.mm_map = r;
            self thread openMatchMenu(1);
            break;
        case 2: self thread pickTimeLimit(); break;
        case 3: self thread pickScoreLimit(); break;
        case 4: self thread startMatch(); break;
        default:
            self.mm_mode = undefined;
            self thread openHubMenu();
            break;
    }
}

oneMap(key)
{
    a = [];
    a[0] = key;
    return a;
}

// Map packs first (the game's own groups) when DLC maps are installed, else the maps straight away
pickMap(maps, current)
{
    self endon("disconnect");
    self endon("death");
    self endon("dcac_reset");

    packs = [];
    for (i = 0; i < maps["pack"].size; i++)
        if (indexOf(packs, maps["pack"][i]) == 0 && (packs.size == 0 || packs[0] != maps["pack"][i]))
            packs[packs.size] = maps["pack"][i];
    pack = maps["pack"][current];
    for (;;)
    {
        if (packs.size > 1)
        {
            names = [];
            for (i = 0; i < packs.size; i++)
                names[i] = level.dcac["pack_name"][int(packs[i])];
            self.cac_mapcap = maps["name"][current];
            p = self pickItem(names, indexOf(packs, pack), oneMap(maps["key"][current]));
            if (p == -1)
                return -1;
            pack = packs[p];
        }
        idx = [];
        names = [];
        keys = [];
        for (i = 0; i < maps["key"].size; i++)
            if (maps["pack"][i] == pack)
            {
                idx[idx.size] = i;
                names[names.size] = maps["name"][i];
                keys[keys.size] = maps["key"][i];
            }
        r = self pickItem(names, indexOf(idx, current), keys);
        if (r != -1)
            return idx[r];
        if (packs.size <= 1)
            return -1;
    }
}

scoreName(mult)
{
    if (mult == "0") return "Unlimited";
    if (mult == "0.5") return "Half";
    if (mult == "2") return "Double";
    return "Default";
}

pickTimeLimit()
{
    self endon("disconnect");
    self endon("death");
    self endon("dcac_reset");

    vals = strTok("0,5,10,15,20,30", ",");
    names = strTok("Unlimited,5 min,10 min,15 min,20 min,30 min", ",");
    self.cac_maps = self.mm_pic;
    self.cac_mapcap = self.mm_cap;
    result = self showMenu("TIME LIMIT", names);
    if (result != -1) self.mm_time = vals[result];
    self thread openMatchMenu(2);
}

pickScoreLimit()
{
    self endon("disconnect");
    self endon("death");
    self endon("dcac_reset");

    // relative to the mode's default, captured before any override
    mult = strTok("0,0.5,1,2", ",");
    names = strTok("Unlimited,Half,Default,Double", ",");
    self.cac_maps = self.mm_pic;
    self.cac_mapcap = self.mm_cap;
    result = self showMenu("SCORE LIMIT", names);
    if (result != -1) self.mm_score = mult[result];
    self thread openMatchMenu(3);
}

startMatch()
{
    self endon("disconnect");

    maps = matchMaps();
    gt = level.dcac["mode"][self.mm_mode];
    setDvar("dcac_opt_timelimit", self.mm_time);
    setDvar("dcac_opt_score", self.mm_score);
    sameMatch = gt == level.gameType && maps["key"][self.mm_map] == getDvar("mapname");
    self cacCleanup();

    if (sameMatch)
    {
        level thread applyMatchOptions();
        self iPrintLnBold("^2Match settings applied");
        self.mm_mode = undefined;
        return;
    }

    rot = "gametype " + gt + " map " + maps["key"][self.mm_map];
    name = maps["name"][self.mm_map] + " - " + level.dcac["mode_name"][self.mm_mode];
    self.mm_mode = undefined;
    setDvar("sv_maprotation", rot);
    setDvar("sv_maprotationcurrent", rot);
    iPrintLnBold("^2Loading ^7" + name);
    wait 2;
    exitLevel(false);
}

// ============================================================
// BOT WARFARE (Bot Warfare reads these dvars live)
// ============================================================

openBotMenu(index)
{
    self endon("disconnect");
    self endon("death");
    self endon("dcac_reset");

    if (isDefined(index)) self.cac_startIndex = index;

    items = [];
    // bots_manage_fill counts the player too
    bots = getDvarInt("bots_manage_fill") - 1;
    if (bots < 0) bots = 0;
    items[0] = "Bot Count: " + bots;
    items[1] = "Difficulty: " + botSkillName(getDvar("bots_skill"));
    if (getDvar("bots_team") == "autoassign" || getDvar("bots_team") == "") items[2] = "Bot Team: Balanced";
    else items[2] = "Bot Team: All Enemies";
    items[3] = "Play Objective: " + onOff(botSetting("bots_play_obj"));
    items[4] = "Camping: " + onOff(botSetting("bots_play_camp"));
    items[5] = "Killstreaks: " + onOff(botSetting("bots_play_killstreak"));
    items[6] = "Jump & Dropshot: " + onOff(botSetting("bots_play_jumpdrop"));
    if (getDvarInt("bots_loadout_allow_op")) items[7] = "Bot Classes: Anything Goes";
    else items[7] = "Bot Classes: Sensible";

    d = [];
    d[0] = "How many bots are in the match (0 to 12).";
    d[1] = "How well bots aim and react.";
    d[2] = "Balanced: bots on both sides. All Enemies: vs you.";
    d[3] = "Bots go for flags, bombs and capture points.";
    d[4] = "Bots sometimes hold a spot and wait for you.";
    d[5] = "Bots call in spy planes, napalm, dogs and more.";
    d[6] = "Bots jump and drop prone during gunfights.";
    d[7] = "Sensible: normal classes. Anything Goes: OP too.";
    self.cac_descs = d;
    self.cac_panel = undefined;
    result = self showMenu("BOT WARFARE", items);
    switch (result)
    {
        case 0: self thread pickBotCount(); break;
        case 1: self thread pickBotSkill(); break;
        case 2:
            if (getDvar("bots_team") == "autoassign" || getDvar("bots_team") == "")
            {
                if (self.team == "axis") setDvar("bots_team", "allies");
                else setDvar("bots_team", "axis");
            }
            else
                setDvar("bots_team", "autoassign");
            self thread openBotMenu(2);
            break;
        case 3: botToggle("bots_play_obj"); self thread openBotMenu(3); break;
        case 4: botToggle("bots_play_camp"); self thread openBotMenu(4); break;
        case 5: botToggle("bots_play_killstreak"); self thread openBotMenu(5); break;
        case 6: botToggle("bots_play_jumpdrop"); self thread openBotMenu(6); break;
        case 7:
            if (getDvarInt("bots_loadout_allow_op"))
            {
                setDvar("bots_loadout_allow_op", "0");
                setDvar("bots_loadout_reasonable", "1");
            }
            else
            {
                setDvar("bots_loadout_allow_op", "1");
                setDvar("bots_loadout_reasonable", "0");
            }
            self thread openBotMenu(7);
            break;
        default: self thread openHubMenu(); break;
    }
}

onOff(v)
{
    if (v) return "On";
    return "Off";
}

botSetting(dvar)
{
    return getDvarInt(dvar);
}

botToggle(dvar)
{
    if (botSetting(dvar)) setDvar(dvar, "0");
    else setDvar(dvar, "1");
}

pickBotCount()
{
    self endon("disconnect");
    self endon("death");
    self endon("dcac_reset");

    // sv_maxclients is 13 on the offline server: 12 bots + the player (fill counts the player too)
    counts = strTok("0,2,4,6,8,10,12", ",");
    result = self showMenu("BOT COUNT", counts);
    if (result != -1)
    {
        fill = int(counts[result]);
        if (fill > 0) fill++;
        setDvar("bots_manage_fill", "" + fill);
    }
    self thread openBotMenu(0);
}

// BO1 bots use Combat Training's difficulty (bots_skill is an alias for bot_difficulty)
pickBotSkill()
{
    self endon("disconnect");
    self endon("death");
    self endon("dcac_reset");

    skills = strTok("easy,normal,hard,fu", ",");
    names = [];
    for (i = 0; i < skills.size; i++)
        names[i] = botSkillName(skills[i]);
    result = self showMenu("DIFFICULTY", names);
    if (result != -1)
    {
        setDvar("bots_skill", skills[result]);
        setDvar("bot_difficulty", skills[result]);
    }
    self thread openBotMenu(1);
}

// BO1's own names (MENU_RULES_DIFFICULTY_*)
botSkillName(s)
{
    if (s == "easy") return "Easy";
    if (s == "hard") return "Hard";
    if (s == "fu") return "Veteran";
    return "Normal";
}

// ============================================================
// GENERIC HUD MENU (built once per open; screens only swap text)
// ============================================================

// Bots hold still while anyone has the menu open. BO1's bots are Combat Training's own AI, which ignores the
// bots_play_* switches WaW's Bot Warfare reads (they kept fighting, PC 2026-10-09): freeze them instead.
botsPause()
{
    if (!isDefined(level.dcac_menus)) level.dcac_menus = 0;
    level.dcac_menus++;
    if (level.dcac_menus == 1)
        level thread botsFreeze();
}

botsResume()
{
    if (!isDefined(level.dcac_menus) || level.dcac_menus <= 0)
        return;
    level.dcac_menus--;
    if (level.dcac_menus > 0)
        return;
    level notify("dcac_bots_resume");
    for (i = 0; i < level.players.size; i++)
        if ((level.players[i] getGuid() + "") == "0")
            level.players[i] freezeControls(false);
}

// Re-applied every second: bots that spawn or join while the menu is open freeze too
botsFreeze()
{
    level endon("dcac_bots_resume");
    for (;;)
    {
        for (i = 0; i < level.players.size; i++)
            if ((level.players[i] getGuid() + "") == "0")
                level.players[i] freezeControls(true);
        wait 1;
    }
}

// A client dvar, sent only when it changed (every send is a reliable command)
cdvar(name, value)
{
    if (!isDefined(self.dcac_cd)) self.dcac_cd = [];
    if (isDefined(self.dcac_cd[name]) && self.dcac_cd[name] == value)
        return;
    self.dcac_cd[name] = value;
    self setClientDvar(name, value);
}

catImage(list, ref)
{
    i = catIndex(list, ref);
    if (i == -1 || level.dcac[list + "_image"][i] == "weapon_missing_image")
        return "";
    return level.dcac[list + "_image"][i];
}

// The class panel beside the list (dcac_p* lines, dcac_i* pictures): the class being edited, else the one in use
cacUpdatePanel()
{
    n = self.cac_panel;
    if (!isDefined(n))
    {
        n = 0;
        if (isDefined(self.dcac_use)) n = self.dcac_use;
    }
    c = self.dcac[n];
    a2 = "";
    if (c["patt2"] != "none") a2 = attName(c["patt2"]);
    lines = [];
    lines[0] = "CUSTOM CLASS " + (n + 1);
    lines[1] = catName("primary", c["primary"]);
    lines[2] = attName(c["patt1"]);
    lines[3] = a2;
    lines[4] = catName("secondary", c["secondary"]);
    lines[5] = attName(c["satt"]);
    lines[6] = catName("specialty1", c["perk1"]);
    lines[7] = catName("specialty2", c["perk2"]);
    lines[8] = catName("specialty3", c["perk3"]);
    lines[9] = catName("primarygrenade", c["lethal"]);
    lines[10] = catName("specialgrenade", c["tactical"]);
    lines[11] = catName("equipment", c["equipment"]);
    lines[12] = catName("killstreak", c["ks1"]) + ", " + catName("killstreak", c["ks2"]) + ", " + catName("killstreak", c["ks3"]);
    for (i = 0; i < lines.size; i++)
        self cdvar("dcac_p" + i, lines[i]);
    pics = [];
    pics[0] = catImage("primary", c["primary"]);
    pics[1] = catImage("secondary", c["secondary"]);
    for (k = 1; k <= 3; k++)
        pics[k + 1] = catImage("specialty" + k, c["perk" + k]);
    pics[5] = catImage("primarygrenade", c["lethal"]);
    pics[6] = catImage("specialgrenade", c["tactical"]);
    pics[7] = catImage("equipment", c["equipment"]);
    for (i = 0; i < pics.size; i++)
        self cdvar("dcac_i" + i, pics[i]);
    // names in BO1's own class list (mod.ff changeclass)
    for (n = 0; n < 5; n++)
        self cdvar("dcac_cc" + (n + 1), "Custom Class " + (n + 1) + ": " + catName("primary", self.dcac[n]["primary"]));
}

// Shows a screen in the mod.ff list menu and returns the picked row, or -1 for Back. Rows, title and the row
// hints (self.cac_descs) go over as client dvars; the menu answers "i,<row>" or "back".
showMenu(title, items)
{
    self endon("disconnect");
    self endon("death");
    self endon("dcac_reset");

    if (!isDefined(self.cac_ui))
    {
        self.cac_ui = true;
        self botsPause();
    }
    descs = self.cac_descs;
    self.cac_descs = undefined;
    maps = self.cac_maps;
    self.cac_maps = undefined;
    cap = self.cac_mapcap;
    self.cac_mapcap = undefined;
    // a screen redrawn after a change starts on the row the player was on (the menu's setfocusbydvar)
    focus = 0;
    if (isDefined(self.cac_startIndex) && self.cac_startIndex < items.size) focus = self.cac_startIndex + 1;
    self.cac_startIndex = undefined;
    self cdvar("dcac_focus", "" + focus);
    self cdvar("dcac_title", title);
    for (i = 0; i < 16; i++)
    {
        row = "";
        hint = "";
        if (i < items.size) row = items[i];
        if (isDefined(descs) && isDefined(descs[i])) hint = descs[i];
        self cdvar("dcac_r" + i, row);
        self cdvar("dcac_d" + i, hint);
    }
    self cacUpdatePanel();
    // Map / Mode screens: BO1's map select picture per row (a single map for every row), else the class panel
    if (isDefined(maps))
    {
        for (i = 0; i < items.size; i++)
        {
            k = maps[0];
            if (isDefined(maps[i])) k = maps[i];
            self cdvar("dcac_m" + i, "menu_" + k + "_map_select_final");
        }
        if (!isDefined(cap)) cap = "";
        self cdvar("dcac_mt", cap);
        self cdvar("dcac_mu", level.dcac["mode_name"][self.mm_mode]);
    }
    else
        self cdvar("dcac_m0", "");
    // reopened, not just refilled: the menu reads dcac_focus only in onOpen
    self closeMenu();
    self openMenu("dcac_list");
    for (;;)
    {
        self waittill("menuresponse", menu, response);
        if (menu != "dcac_list")
            continue;
        self dlog("list " + response);
        if (response == "back")
            return -1;
        if (getSubStr(response, 0, 2) == "i,")
            return int(getSubStr(response, 2));
    }
}


